APP_ENV=development
APP_BASE_URL=http://localhost:3000
APP_TIMEZONE=Asia/Jakarta
LOG_LEVEL=info
HTTP_ADDR=:8080
GRPC_ADDR=:9090
# Separate multiple frontend origins with commas.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://crm-system-gold-three.vercel.app
DATABASE_URL=postgres://crm:crm@localhost:5432/crm?sslmode=disable
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL=24h
BCRYPT_COST=12
# Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
TELEGRAM_WORKER_INTERVAL=5s
TELEGRAM_WORKER_BATCH_SIZE=20
